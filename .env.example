# ======================================================
# PROJECT 4 – ENVIRONMENT CONFIGURATION TEMPLATE
# ======================================================
# Copy this file to `.env` and fill required values.
# Do NOT commit `.env` to version control.

# ======================================================
# SYSTEM USER MAPPING
# ======================================================
# Match these values to your host user ID (run: id)
PUID=1000
PGID=1000

# ======================================================
# N8N CORE SETTINGS
# ======================================================
N8N_VERSION=2.9.3
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=false

# Restrict file access for Read/Write Files + Code Node
N8N_RESTRICT_FILE_ACCESS_TO=/home/node/.n8n-files;/home/node/data

# ======================================================
# CODE NODE RESTRICTIONS
# ======================================================
# Only allow specific built-in Node.js modules
NODE_FUNCTION_ALLOW_BUILTIN=fs,path
# Only allow specific external modules (comma-separated)
NODE_FUNCTION_ALLOW_EXTERNAL=

# ======================================================
# FILE SYSTEM SECURITY
# ======================================================
# Set to true in production environments
N8N_BLOCK_FS_WRITE_ACCESS=false
N8N_BLOCK_FS_READ_ACCESS=false

# ======================================================
# API CREDENTIALS
# ======================================================
# Insert your API keys below

GOOGLE_PALM_API_KEY=YOUR_API_KEY_HERE

# Telegram bot token from BotFather
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Telegram chat ID for notifications
TELEGRAM_CHAT_ID=YOUR_CHAT_ID